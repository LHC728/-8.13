{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "observation_calibration_v1.schema.json",
  "title": "G2-01 observation calibration request and response envelope",
  "description": "Shared read-only interface schema. Decimal quantities are strings to avoid binary-float preprocessing.",
  "oneOf": [
    { "$ref": "#/$defs/requestEnvelope" },
    { "$ref": "#/$defs/responseEnvelope" },
    { "$ref": "#/$defs/checkReportEnvelope" },
    { "$ref": "#/$defs/runManifestEnvelope" },
    { "$ref": "#/$defs/commandLogEnvelope" }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
    },
    "decimalProbability": {
      "type": "string",
      "pattern": "^(0(?:\\.[0-9]+)?|1(?:\\.0+)?)$"
    },
    "decimalNonnegative": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
    },
    "decimalSigned": {
      "type": "string",
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
    },
    "semantics": {
      "enum": [
        "single_test_unconditional_v1",
        "standard_chain_v1"
      ]
    },
    "scenarioRole": {
      "enum": ["canonical_g2_abc", "generic", "test_oracle"]
    },
    "parameterRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "q_parameter_id", "e_parameter_id"],
      "properties": {
        "source": { "const": "02_数据/parameters.csv" },
        "q_parameter_id": { "type": "string", "pattern": "^P[0-9]{3}$" },
        "e_parameter_id": { "type": "string", "pattern": "^P[0-9]{3}$" }
      }
    },
    "directValues": {
      "type": "object",
      "additionalProperties": false,
      "required": ["q", "e"],
      "properties": {
        "q": { "$ref": "#/$defs/decimalProbability" },
        "e": { "$ref": "#/$defs/decimalProbability" }
      }
    },
    "requestItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["process_id"],
      "properties": {
        "process_id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "canonical_parameter_ref": { "$ref": "#/$defs/parameterRef" },
        "direct_values": { "$ref": "#/$defs/directValues" }
      },
      "oneOf": [
        { "required": ["canonical_parameter_ref"], "not": { "required": ["direct_values"] } },
        { "required": ["direct_values"], "not": { "required": ["canonical_parameter_ref"] } }
      ]
    },
    "requestEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "envelope_type",
        "request_id",
        "scenario_role",
        "semantics",
        "items"
      ],
      "properties": {
        "schema_version": { "const": "observation_calibration_v1" },
        "envelope_type": { "const": "calibration_request" },
        "request_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "scenario_role": { "$ref": "#/$defs/scenarioRole" },
        "semantics": { "$ref": "#/$defs/semantics" },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/requestItem" }
        }
      }
    },
    "residuals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["equation_1_abs", "equation_2_abs", "balance_abs"],
      "properties": {
        "equation_1_abs": { "$ref": "#/$defs/decimalNonnegative" },
        "equation_2_abs": { "$ref": "#/$defs/decimalNonnegative" },
        "balance_abs": { "$ref": "#/$defs/decimalNonnegative" }
      }
    },
    "bracket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variable", "lower", "upper", "final_width"],
      "properties": {
        "variable": { "enum": ["NONE", "t", "alpha", "beta"] },
        "lower": { "type": ["string", "null"] },
        "upper": { "type": ["string", "null"] },
        "final_width": { "type": ["string", "null"] }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "feasibility",
        "uniqueness",
        "iterations",
        "bracket",
        "residuals",
        "tolerance_profile"
      ],
      "properties": {
        "method": {
          "enum": [
            "closed_form",
            "scalar_t_bisection",
            "independent_nested_alpha_beta_bisection",
            "endpoint_analysis",
            "feasibility_only"
          ]
        },
        "feasibility": { "enum": ["FEASIBLE", "INFEASIBLE"] },
        "uniqueness": {
          "enum": ["UNIQUE", "NONIDENTIFIABLE_FAMILY", "NO_SOLUTION"]
        },
        "iterations": { "type": "integer", "minimum": 0, "maximum": 300 },
        "bracket": { "$ref": "#/$defs/bracket" },
        "residuals": {
          "oneOf": [
            { "$ref": "#/$defs/residuals" },
            { "type": "null" }
          ]
        },
        "tolerance_profile": { "const": "observation_calibration_v1_tol" },
        "notes": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "resultItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "process_id",
        "status",
        "q",
        "e",
        "alpha",
        "beta",
        "e_max",
        "free_parameters",
        "diagnostics"
      ],
      "properties": {
        "process_id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "status": {
          "enum": ["UNIQUE_SOLUTION", "NONIDENTIFIABLE_FAMILY", "INFEASIBLE"]
        },
        "q": { "$ref": "#/$defs/decimalProbability" },
        "e": { "$ref": "#/$defs/decimalProbability" },
        "alpha": {
          "oneOf": [
            { "$ref": "#/$defs/decimalProbability" },
            { "type": "null" }
          ]
        },
        "beta": {
          "oneOf": [
            { "$ref": "#/$defs/decimalProbability" },
            { "type": "null" }
          ]
        },
        "e_max": {
          "oneOf": [
            { "$ref": "#/$defs/decimalProbability" },
            { "type": "null" }
          ]
        },
        "free_parameters": {
          "type": "array",
          "items": { "enum": ["alpha", "beta"] },
          "uniqueItems": true,
          "maxItems": 1
        },
        "diagnostics": { "$ref": "#/$defs/diagnostics" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "UNIQUE_SOLUTION" } } },
          "then": {
            "properties": {
              "alpha": { "$ref": "#/$defs/decimalProbability" },
              "beta": { "$ref": "#/$defs/decimalProbability" },
              "free_parameters": { "maxItems": 0 }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "INFEASIBLE" } } },
          "then": {
            "properties": {
              "alpha": { "type": "null" },
              "beta": { "type": "null" },
              "free_parameters": { "maxItems": 0 }
            }
          }
        }
      ]
    },
    "responseEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "envelope_type",
        "request_id",
        "scenario_role",
        "semantics",
        "overall_status",
        "results"
      ],
      "properties": {
        "schema_version": { "const": "observation_calibration_v1" },
        "envelope_type": { "const": "calibration_response" },
        "request_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "scenario_role": { "$ref": "#/$defs/scenarioRole" },
        "semantics": { "$ref": "#/$defs/semantics" },
        "overall_status": {
          "enum": [
            "ALL_IDENTIFIED",
            "HAS_NONIDENTIFIABLE",
            "HAS_INFEASIBLE",
            "FAILED_VALIDATION",
            "NUMERICAL_FAILURE"
          ]
        },
        "results": {
          "type": "array",
          "items": { "$ref": "#/$defs/resultItem" }
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string", "minLength": 1 },
              "message": { "type": "string", "minLength": 1 },
              "item_index": { "type": ["integer", "null"], "minimum": 0 }
            }
          }
        }
      }
    },
    "parameterCertificate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_alpha_lo", "root_alpha_hi", "root_alpha_span",
        "root_beta_lo", "root_beta_hi", "root_beta_span",
        "reported_alpha_lo", "reported_alpha_hi", "reported_alpha_span",
        "reported_beta_lo", "reported_beta_hi", "reported_beta_span"
      ],
      "properties": {
        "root_alpha_lo": { "$ref": "#/$defs/decimalProbability" },
        "root_alpha_hi": { "$ref": "#/$defs/decimalProbability" },
        "root_alpha_span": { "$ref": "#/$defs/decimalNonnegative" },
        "root_beta_lo": { "$ref": "#/$defs/decimalProbability" },
        "root_beta_hi": { "$ref": "#/$defs/decimalProbability" },
        "root_beta_span": { "$ref": "#/$defs/decimalNonnegative" },
        "reported_alpha_lo": { "$ref": "#/$defs/decimalProbability" },
        "reported_alpha_hi": { "$ref": "#/$defs/decimalProbability" },
        "reported_alpha_span": { "$ref": "#/$defs/decimalNonnegative" },
        "reported_beta_lo": { "$ref": "#/$defs/decimalProbability" },
        "reported_beta_hi": { "$ref": "#/$defs/decimalProbability" },
        "reported_beta_span": { "$ref": "#/$defs/decimalNonnegative" }
      }
    },
    "existenceDiagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method", "alpha_outer_R_lower", "alpha_outer_R_upper",
        "inner_bracket_status", "inner_bracket_count",
        "root_internal_max_residual", "response_certificate_status", "root_relation"
      ],
      "properties": {
        "method": {
          "enum": ["closed_form_back_substitution", "independent_nested_alpha_beta_bisection", "endpoint_analysis", "feasibility_only"]
        },
        "alpha_outer_R_lower": {
          "oneOf": [{ "$ref": "#/$defs/decimalSigned" }, { "type": "null" }]
        },
        "alpha_outer_R_upper": {
          "oneOf": [{ "$ref": "#/$defs/decimalSigned" }, { "type": "null" }]
        },
        "inner_bracket_status": { "enum": ["ALL_VALID", "NOT_APPLICABLE", "FAILED"] },
        "inner_bracket_count": { "type": "integer", "minimum": 0, "maximum": 300 },
        "root_internal_max_residual": {
          "oneOf": [{ "$ref": "#/$defs/decimalNonnegative" }, { "type": "null" }]
        },
        "response_certificate_status": { "enum": ["PASS", "FAIL", "NOT_APPLICABLE"] },
        "root_relation": { "enum": ["CLOSED_FORM_ROOT_CONTAINED", "ROOT_INTERVALS_INTERSECT", "NOT_APPLICABLE", "FAILED"] }
      }
    },
    "checkItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "process_id", "status", "response_result_status", "response_free_parameters",
        "independent_result_status", "independent_free_parameters",
        "independent_alpha", "independent_beta", "independent_residuals", "max_original_residual",
        "independent_certificate", "existence_diagnostics", "message"
      ],
      "properties": {
        "process_id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "status": { "enum": ["PASS", "FAIL"] },
        "response_result_status": { "enum": ["UNIQUE_SOLUTION", "NONIDENTIFIABLE_FAMILY", "INFEASIBLE"] },
        "response_free_parameters": {
          "type": "array", "maxItems": 1, "uniqueItems": true,
          "items": { "enum": ["alpha", "beta"] }
        },
        "independent_result_status": { "enum": ["UNIQUE_SOLUTION", "NONIDENTIFIABLE_FAMILY", "INFEASIBLE"] },
        "independent_free_parameters": {
          "type": "array", "maxItems": 1, "uniqueItems": true,
          "items": { "enum": ["alpha", "beta"] }
        },
        "independent_alpha": {
          "oneOf": [{ "$ref": "#/$defs/decimalProbability" }, { "type": "null" }]
        },
        "independent_beta": {
          "oneOf": [{ "$ref": "#/$defs/decimalProbability" }, { "type": "null" }]
        },
        "max_original_residual": {
          "oneOf": [{ "$ref": "#/$defs/decimalNonnegative" }, { "type": "null" }]
        },
        "independent_residuals": {
          "oneOf": [{ "$ref": "#/$defs/residuals" }, { "type": "null" }]
        },
        "independent_certificate": {
          "oneOf": [{ "$ref": "#/$defs/parameterCertificate" }, { "type": "null" }]
        },
        "existence_diagnostics": { "$ref": "#/$defs/existenceDiagnostics" },
        "message": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "independent_result_status": { "const": "UNIQUE_SOLUTION" } }, "required": ["independent_result_status"] },
          "then": {
            "properties": {
              "independent_alpha": { "$ref": "#/$defs/decimalProbability" },
              "independent_beta": { "$ref": "#/$defs/decimalProbability" },
              "independent_residuals": { "$ref": "#/$defs/residuals" },
              "independent_certificate": { "$ref": "#/$defs/parameterCertificate" },
              "max_original_residual": { "$ref": "#/$defs/decimalNonnegative" },
              "existence_diagnostics": {
                "properties": { "root_internal_max_residual": { "$ref": "#/$defs/decimalNonnegative" } }
              },
              "independent_free_parameters": { "maxItems": 0 }
            }
          },
          "else": {
            "properties": {
              "independent_residuals": { "type": "null" },
              "max_original_residual": { "type": "null" },
              "independent_certificate": { "type": "null" },
              "existence_diagnostics": {
                "properties": { "root_internal_max_residual": { "type": "null" } }
              }
            }
          }
        },
        {
          "if": { "properties": { "independent_result_status": { "const": "INFEASIBLE" } }, "required": ["independent_result_status"] },
          "then": {
            "properties": {
              "independent_alpha": { "type": "null" },
              "independent_beta": { "type": "null" },
              "independent_free_parameters": { "maxItems": 0 }
            }
          }
        },
        {
          "if": { "properties": { "independent_result_status": { "const": "NONIDENTIFIABLE_FAMILY" } }, "required": ["independent_result_status"] },
          "then": {
            "properties": { "independent_free_parameters": { "minItems": 1, "maxItems": 1 } }
          }
        },
        {
          "if": { "properties": { "independent_free_parameters": { "contains": { "const": "alpha" } } }, "required": ["independent_free_parameters"] },
          "then": {
            "properties": {
              "independent_alpha": { "type": "null" },
              "independent_beta": { "$ref": "#/$defs/decimalProbability" }
            }
          }
        },
        {
          "if": { "properties": { "independent_free_parameters": { "contains": { "const": "beta" } } }, "required": ["independent_free_parameters"] },
          "then": {
            "properties": {
              "independent_alpha": { "$ref": "#/$defs/decimalProbability" },
              "independent_beta": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "response_result_status": { "const": "NONIDENTIFIABLE_FAMILY" } }, "required": ["response_result_status"] },
          "then": { "properties": { "response_free_parameters": { "minItems": 1, "maxItems": 1 } } },
          "else": { "properties": { "response_free_parameters": { "maxItems": 0 } } }
        }
      ]
    },
    "checkReportEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "envelope_type", "run_id", "registry_version", "check_ids",
        "scenario_role", "semantics", "checker_status", "response_sha256", "parameters_sha256",
        "schema_sha256", "task_package_sha256", "checked_result_count", "items"
      ],
      "properties": {
        "schema_version": { "const": "observation_calibration_v1" },
        "envelope_type": { "const": "calibration_check_report" },
        "run_id": { "type": "string", "pattern": "^[0-9]{8}T[0-9]{12}Z_[0-9a-f]{8}$" },
        "registry_version": { "const": "CR-V3.1" },
        "check_ids": {
          "type": "array", "minItems": 2, "uniqueItems": true,
          "items": { "enum": ["CR-V3.1/C01", "CR-V3.1/C02", "CR-V3.1/C19", "CR-V3.1/C21"] }
        },
        "scenario_role": { "$ref": "#/$defs/scenarioRole" },
        "semantics": { "$ref": "#/$defs/semantics" },
        "checker_status": { "enum": ["PASS", "FAIL", "VALIDATION_ERROR", "NUMERICAL_ERROR"] },
        "response_sha256": { "$ref": "#/$defs/sha256" },
        "parameters_sha256": { "$ref": "#/$defs/sha256" },
        "schema_sha256": { "$ref": "#/$defs/sha256" },
        "task_package_sha256": { "$ref": "#/$defs/sha256" },
        "checked_result_count": { "type": "integer", "minimum": 0 },
        "items": { "type": "array", "items": { "$ref": "#/$defs/checkItem" } },
        "errors": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "artifactRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role", "sha256", "bytes"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "role": {
          "enum": ["task_package", "parameters", "schema", "oracle_fixture", "request", "response", "check_report", "command_log", "stdout_log", "stderr_log", "source_code", "test_code"]
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 0 },
        "source_sha256_before": { "$ref": "#/$defs/sha256" },
        "source_sha256_after": { "$ref": "#/$defs/sha256" }
      },
      "allOf": [
        {
          "if": { "properties": { "role": { "enum": ["source_code", "test_code"] } }, "required": ["role"] },
          "then": { "required": ["source_sha256_before", "source_sha256_after"] }
        }
      ]
    },
    "runManifestEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "envelope_type", "run_id", "state_version", "registry_version",
        "task_package_version", "created_utc", "runner", "python_version", "canonical_process_order",
        "semantics_run_order", "artifacts", "overall_status"
      ],
      "properties": {
        "schema_version": { "const": "observation_calibration_v1" },
        "envelope_type": { "const": "calibration_run_manifest" },
        "run_id": { "type": "string", "pattern": "^[0-9]{8}T[0-9]{12}Z_[0-9a-f]{8}$" },
        "state_version": { "const": "STATE-2026-08-13-G2.2" },
        "registry_version": { "const": "CR-V3.1" },
        "task_package_version": { "type": "string", "minLength": 1 },
        "created_utc": { "type": "string", "format": "date-time" },
        "runner": { "const": "04_代码/scripts/run_g2_01_v1.py" },
        "python_version": { "type": "string", "minLength": 1 },
        "canonical_process_order": { "const": ["A", "B", "C"] },
        "semantics_run_order": { "const": ["single_test_unconditional_v1", "standard_chain_v1"] },
        "artifacts": { "type": "array", "minItems": 0, "items": { "$ref": "#/$defs/artifactRecord" } },
        "overall_status": { "enum": ["PASS", "FAIL", "INCOMPLETE"] },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "commandRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "argv", "cwd", "started_utc", "finished_utc", "exit_code", "stdout_path", "stderr_path"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "argv": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "cwd": { "$ref": "#/$defs/relativePath" },
        "started_utc": { "type": "string", "format": "date-time" },
        "finished_utc": { "type": "string", "format": "date-time" },
        "exit_code": { "type": "integer" },
        "stdout_path": { "$ref": "#/$defs/relativePath" },
        "stderr_path": { "$ref": "#/$defs/relativePath" }
      }
    },
    "commandLogEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "envelope_type", "run_id", "commands"],
      "properties": {
        "schema_version": { "const": "observation_calibration_v1" },
        "envelope_type": { "const": "calibration_command_log" },
        "run_id": { "type": "string", "pattern": "^[0-9]{8}T[0-9]{12}Z_[0-9a-f]{8}$" },
        "commands": { "type": "array", "minItems": 0, "items": { "$ref": "#/$defs/commandRecord" } }
      }
    }
  }
}
