# Default: auto-detect text vs binary, normalize to LF
* text=auto eol=lf

# Source code — LF
*.py     text eol=lf
*.js     text eol=lf
*.ts     text eol=lf
*.sh     text eol=lf
*.sql    text eol=lf

# Markup & config — LF
*.md     text eol=lf
*.json   text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.toml   text eol=lf
*.txt    text eol=lf
*.csv    text eol=lf
*.tex    text eol=lf
*.html   text eol=lf
*.css    text eol=lf
*.xml    text eol=lf
*.ini    text eol=lf
*.cfg    text eol=lf

# Windows scripts — CRLF
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf

# Binary — no diff, no EOL conversion
*.pdf    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.bmp    binary
*.ico    binary
*.svg    binary
*.zip    binary
*.7z     binary
*.rar    binary
*.tar    binary
*.gz     binary
*.xlsx   binary
*.xls    binary
*.docx   binary
*.doc    binary
*.pptx   binary
*.ppt    binary
*.npy    binary
*.npz    binary
*.pkl    binary
*.drawio binary

# G2 formal run evidence — preserve original bytes (no EOL normalization)
# Formal run evidence records runner-produced SHA-256 of the actual bytes;
# CRLF/LF auto-normalization would break byte-addressed evidence integrity.
# Both text and eol must be unset: the repo-wide "* eol=lf" rule would
# otherwise still force conversion on add/checkout.
competitions/模拟赛_研究生A题/05_结果/G2/run_*/** -text -eol
