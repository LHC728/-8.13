<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2024-01-01T00:00:00.000Z" agent="drawio" version="21.0.0">
  <diagram name="湖羊生产周期" id="production_cycle">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 标题 -->
        <mxCell id="title" value="湖羊连续生产周期流程图" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=16;fontStyle=1;fontFamily=SimSun;" vertex="1" parent="1">
          <mxGeometry x="240" y="20" width="320" height="30" as="geometry" />
        </mxCell>

        <!-- 配种阶段 -->
        <mxCell id="mate_box" value="配种期&lt;br&gt;20天&lt;br&gt;1只公羊 + 最多14只母羊/栏" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontFamily=SimSun;" vertex="1" parent="1">
          <mxGeometry x="300" y="70" width="180" height="70" as="geometry" />
        </mxCell>

        <!-- 怀孕阶段 -->
        <mxCell id="preg_box" value="怀孕期&lt;br&gt;149天&lt;br&gt;不超过8只/栏" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontFamily=SimSun;" vertex="1" parent="1">
          <mxGeometry x="300" y="180" width="180" height="70" as="geometry" />
        </mxCell>

        <!-- 哺乳阶段 -->
        <mxCell id="nurs_box" value="哺乳期&lt;br&gt;40天&lt;br&gt;不超过6只母羊+羔羊/栏" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontFamily=SimSun;" vertex="1" parent="1">
          <mxGeometry x="300" y="290" width="180" height="70" as="geometry" />
        </mxCell>

        <!-- 休整阶段 -->
        <mxCell id="rest_box" value="空怀休整期&lt;br&gt;20天&lt;br&gt;不超过14只/栏" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontFamily=SimSun;" vertex="1" parent="1">
          <mxGeometry x="300" y="400" width="180" height="70" as="geometry" />
        </mxCell>

        <!-- 育肥阶段 -->
        <mxCell id="fatt_box" value="羔羊育肥期&lt;br&gt;210天&lt;br&gt;不超过14只/栏" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontFamily=SimSun;" vertex="1" parent="1">
          <mxGeometry x="560" y="290" width="180" height="70" as="geometry" />
        </mxCell>

        <!-- 出栏 -->
        <mxCell id="output_box" value="出栏&lt;br&gt;育肥完成" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;fontSize=11;fontFamily=SimSun;" vertex="1" parent="1">
          <mxGeometry x="560" y="400" width="180" height="70" as="geometry" />
        </mxCell>

        <!-- 箭头: 配种→怀孕 -->
        <mxCell id="arrow1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=2;" edge="1" parent="1" source="mate_box" target="preg_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 箭头: 怀孕→哺乳 -->
        <mxCell id="arrow2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=2;" edge="1" parent="1" source="preg_box" target="nurs_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 箭头: 哺乳→休整 -->
        <mxCell id="arrow3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=2;" edge="1" parent="1" source="nurs_box" target="rest_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 箭头: 哺乳→育肥 (羔羊) -->
        <mxCell id="arrow4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#9673a6;" edge="1" parent="1" source="nurs_box" target="fatt_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lamb_label" value="断奶羔羊" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;fontFamily=SimSun;" vertex="1" connectable="0" parent="arrow4">
          <mxGeometry x="-0.2" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- 箭头: 育肥→出栏 -->
        <mxCell id="arrow5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=2;" edge="1" parent="1" source="fatt_box" target="output_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 休整→配种 (循环箭头) -->
        <mxCell id="arrow6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#b85450;dashed=1;" edge="1" parent="1" source="rest_box" target="mate_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cycle_label" value="进入下一周期&lt;br&gt;(周期229天)" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;fontFamily=SimSun;fontColor=#b85450;" vertex="1" connectable="0" parent="arrow6">
          <mxGeometry x="-0.2" relative="1" as="geometry">
            <mxPoint x="-30" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- 标注：完整周期 -->
        <mxCell id="cycle_note" value="完整繁殖周期 = 229天&lt;br&gt;每只母羊每年约1.59个周期&lt;br&gt;每只母羊年产羔 ≈ 3.2只" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontFamily=SimSun;fillColor=#f5f5f5;strokeColor=#666666;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="210" width="180" height="70" as="geometry" />
        </mxCell>

        <!-- 图例 -->
        <mxCell id="legend_title" value="图例" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontFamily=SimSun;" vertex="1" parent="1">
          <mxGeometry x="60" y="70" width="60" height="20" as="geometry" />
        </mxCell>
        <mxCell id="legend_mate" value="配种" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;fontFamily=SimSun;" vertex="1" parent="1">
          <mxGeometry x="60" y="95" width="50" height="20" as="geometry" />
        </mxCell>
        <mxCell id="legend_preg" value="怀孕" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;fontFamily=SimSun;" vertex="1" parent="1">
          <mxGeometry x="120" y="95" width="50" height="20" as="geometry" />
        </mxCell>
        <mxCell id="legend_nurs" value="哺乳" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;fontFamily=SimSun;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="50" height="20" as="geometry" />
        </mxCell>
        <mxCell id="legend_rest" value="休整" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;fontFamily=SimSun;" vertex="1" parent="1">
          <mxGeometry x="120" y="120" width="50" height="20" as="geometry" />
        </mxCell>
        <mxCell id="legend_fatt" value="育肥" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;fontFamily=SimSun;" vertex="1" parent="1">
          <mxGeometry x="60" y="145" width="50" height="20" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
